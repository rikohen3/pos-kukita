generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String?
  items    String?   
  products Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    
  products Product[]
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  image       String?
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  supplierId  Int
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  buyPrice    Int           
  sellPrice   Int           
  stock       Int           @default(0)
  imageUrl    String?       @default("https://cdn-icons-png.flaticon.com/512/3081/3081840.png")
  packageItems PackageItem[]
  saleItems    SaleItem[]
  orderItems   OrderItem[]  // Relasi baru ke Buku Pesanan
}

model Package {
  id          Int           @id @default(autoincrement())
  name        String   
  image       String?     
  sellPrice   Int
  isActive    Boolean       @default(true)
  items       PackageItem[]
  saleItems   SaleItem[]
  orderItems  OrderItem[]   // Relasi baru ke Buku Pesanan
}

model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId Int
  package   Package @relation(fields: [packageId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     
}

model Sale {
  id            Int        @id @default(autoincrement())
  invoice       String     @unique
  totalAmount   Int
  paymentMethod String     
  cashReceived  Int?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id])
  qty       Int
  price     Int
  subtotal  Int
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   
  description String
  amount      Int
  createdAt   DateTime @default(now())
}

model Setting {
  id    Int    @id @default(1)
  name  String @unique
  value String
}

model StockHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  productName String
  qtyAdded    Int
  newTotal    Int
  createdAt   DateTime @default(now())
}

model Cashier {
  id   Int    @id @default(autoincrement())
  name String
  pin  String @unique
}

// ==========================================
// KAMAR BARU UNTUK FITUR BUKU PESANAN (PO)
// ==========================================

model Order {
  id            Int         @id @default(autoincrement())
  invoice       String      @unique
  customerName  String
  customerPhone String?
  pickupDate    DateTime    // Kapan kue ini akan diambil
  totalAmount   Int         // Total harga kue saja
  shippingCost  Int         @default(0) // Biaya ongkos kirim (opsional)
  downPayment   Int         @default(0) // Uang Muka (DP) yang dibayar hari ini
  paymentMethod String?     // Tunai / QRIS (untuk DP atau Pelunasan)
  status        String      @default("Menunggu") // Menunggu, Selesai, Batal
  paymentStatus String      @default("Belum Lunas") // Belum Lunas, Lunas
  notes         String?     // Catatan khusus (misal: "Kue jangan terlalu manis")
  cashierName   String      // Nama kasir yang mencatat pesanan
  createdAt     DateTime    @default(now()) // Waktu pesanan dibuat
  items         OrderItem[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id])
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
  packageId   Int?
  package     Package? @relation(fields: [packageId], references: [id])
  qty         Int
  price       Int
  subtotal    Int
}